<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<a href="/">Inicial</a><br>
<a href="/filmes">Filmes</a>

<h1>Detalhar Filme</h1>

<hr>

<h2>{{filme.nome}} ({{filme.ano}})</h2>

<ul>
  <li>
    <label>Nome:</label>
    {{filme.nome}}
  </li>

  <li>
    <label>Ano:</label>
    {{filme.ano}}
  </li>

  <li>
    <label>Diretor:</label>
    <a href="/diretores/{{filme.diretor.id}}">
      {{filme.diretor.nome}} -
      {{filme.diretor.anoNascimento}} -
      {{filme.diretor.nacionalidade}}
    </a>
  </li>
</ul>

<hr>

<h3>Artistas</h3>

{{#if filme.artistas}}
  <ul>
    {{#each filme.artistas}}
      <li>
        <a href="/artistas/{{this.id}}">
          {{this.nome}} - {{this.anoNascimento}}
        </a>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p>Nenhum artista cadastrado.</p>
{{/if}}

<hr>

<h3>Ficha Técnica</h3>

{{#if filme.fichaTecnica}}
  <ul>
    <li>
      Duração: {{filme.fichaTecnica.duracaoMinutos}} minutos
    </li>
    <li>
      Orçamento: {{filme.fichaTecnica.orcamento}}
    </li>
    <li>
      Bilheteria: {{filme.fichaTecnica.bilheteria}}
    </li>
  </ul>
{{else}}
  <a href="/filmes/{{filme.id}}/ficha-tecnica/cadastrar">
    Cadastrar ficha técnica
  </a>
{{/if}}