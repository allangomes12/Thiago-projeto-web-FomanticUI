<h1 class="ui header"><i class="edit icon"></i><div class="content">Editar artista</div></h1>

<div class="ui segment">
  <form class="ui form" action="/artistas/{{artista.id}}?_method=PUT" method="POST">
    <div class="field">
      <label>Nome do artista</label>
      <input type="text" name="nome" value="{{artista.nome}}">
    </div>

    <div class="two fields">
      <div class="field">
        <label>Ano de nascimento</label>
        <input type="number" name="anoNascimento" value="{{artista.anoNascimento}}">
      </div>
      <div class="field">
        <label>Nome artístico</label>
        <input type="text" name="nomeArtistico" value="{{artista.nomeArtistico}}">
      </div>
    </div>

    <div class="field">
      <div class="ui checkbox">
        <input type="checkbox" name="emAtividade" {{#if artista.emAtividade}}checked{{/if}}>
        <label>Em atividade</label>
      </div>
    </div>

    <div class="field">
      <label>Foto (endereço da imagem)</label>
      <input type="text" name="foto" value="{{artista.foto}}">
    </div>

    <div class="field">
      <label>Filmes</label>
      <select class="ui fluid dropdown" name="filmes" multiple>
        {{#each filmes}}
          <option value="{{this.id}}" {{#if (eq this.id @root.artista.filmeId)}}selected{{/if}}>
            {{this.nome}}
          </option>
        {{/each}}
      </select>
    </div>

    <button class="ui green button" type="submit"><i class="save icon"></i> Salvar alterações</button>
    <a class="ui basic button" href="/artistas">Cancelar</a>
  </form>
</div>