<div class="ui clearing basic segment">
  <h1 class="ui left floated header">
    <i class="users icon"></i>
    <div class="content">
      Artistas
      <div class="sub header">Lista de artistas cadastrados</div>
    </div>
  </h1>
  <a class="ui green right floated button" href="/artistas/cadastrar">
    <i class="plus icon"></i> Cadastrar artista
  </a>
</div>

<div class="ui segment">
  <div class="ui very relaxed divided middle aligned list">
    {{#each artistas}}
      <div class="item">
        <div class="right floated content">
          <a class="ui icon basic green button" href="/artistas/{{this.id}}/editar" title="Editar">
            <i class="edit icon"></i>
          </a>
          <form class="form-inline" action="/artistas/{{this.id}}?_method=DELETE" method="POST" onsubmit="return confirm('Excluir este artista?');">
            <button class="ui icon basic red button" type="submit" title="Excluir">
              <i class="trash icon"></i>
            </button>
          </form>
        </div>
        <div class="content">
          <a class="header" href="/artistas/{{this.id}}">{{this.nome}}</a>
          <div class="description">{{this.nomeArtistico}} - {{this.anoNascimento}}</div>
        </div>
      </div>
    {{else}}
      <div class="item"><div class="content">Nenhum artista cadastrado ainda.</div></div>
    {{/each}}
  </div>
</div>