<div class="ui clearing basic segment">
  <h1 class="ui left floated header">
    <i class="film icon"></i>
    <div class="content">
      Filmes
      <div class="sub header">Lista de filmes cadastrados</div>
    </div>
  </h1>
  <a class="ui green right floated button" href="/filmes/cadastrar">
    <i class="plus icon"></i> Cadastrar filme
  </a>
</div>

<div class="ui segment">
  <div class="ui very relaxed divided middle aligned list">
    {{#each filmes}}
      <div class="item">
        <div class="right floated content">
          <a class="ui icon basic green button" href="/filmes/{{this.id}}/editar" title="Editar">
            <i class="edit icon"></i>
          </a>
          <form class="form-inline" action="/filmes/{{this.id}}?_method=DELETE" method="POST" onsubmit="return confirm('Excluir este filme?');">
            <button class="ui icon basic red button" type="submit" title="Excluir">
              <i class="trash icon"></i>
            </button>
          </form>
        </div>
        <div class="content">
          <a class="header" href="/filmes/{{this.id}}">{{this.nome}}</a>
          <div class="description">{{this.ano}}</div>
        </div>
      </div>
    {{else}}
      <div class="item"><div class="content">Nenhum filme cadastrado ainda.</div></div>
    {{/each}}
  </div>
</div>