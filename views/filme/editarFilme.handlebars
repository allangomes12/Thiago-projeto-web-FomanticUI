<h1 class="ui header"><i class="edit icon"></i><div class="content">Editar filme</div></h1>

<div class="ui segment">
  <form class="ui form" action="/filmes/{{filme.id}}?_method=PUT" method="POST">
    <div class="field">
      <label>Nome do filme</label>
      <input type="text" name="nome" value="{{filme.nome}}">
    </div>

    <div class="field">
      <label>Ano</label>
      <input type="number" name="ano" value="{{filme.ano}}">
    </div>

    <div class="field">
      <label>Diretor</label>
      <select class="ui fluid dropdown" name="diretorId">
        {{#each diretores}}
          <option value="{{this.id}}" {{#if (eq this.id @root.filme.diretorId)}}selected{{/if}}>
            {{this.nome}}
          </option>
        {{/each}}
      </select>
    </div>

    <div class="field">
      <label>Artistas</label>
      <select class="ui fluid dropdown" name="artistas" multiple>
        {{#each artistas}}
          <option value="{{this.id}}" {{#if (eq this.id @root.filme.artistaId)}}selected{{/if}}>
            {{this.nome}}
          </option>
        {{/each}}
      </select>
    </div>

    <button class="ui green button" type="submit"><i class="save icon"></i> Salvar alterações</button>
    <a class="ui basic button" href="/filmes">Cancelar</a>
  </form>
</div>